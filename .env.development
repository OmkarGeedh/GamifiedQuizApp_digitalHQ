# ==============================================================================
# Development Environment Configuration (.env.development)
# Used when ENV=development or running locally (go run . / make run)
# ==============================================================================

# Server Runtime
PORT=8080
ENV=development
COOKIE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=*
SEED_ON_BOOT=true
SEED_DEMO_USER=true
SEED_FORCE_REFRESH=false

# PostgreSQL Database (Local Development)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=skillverse
POSTGRES_PASSWORD=skillverse_secrets
POSTGRES_DB=gamifiedapp
POSTGRES_SSLMODE=disable
DATABASE_URL=postgresql://skillverse:skillverse_secrets@127.0.0.1:5433/gamifiedapp?sslmode=disable

# Redis Cache (Local Development)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# pgAdmin
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL=admin@skillverse.com
PGADMIN_DEFAULT_PASSWORD=admin

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_quizapp_2026
PASSWORD_SECRET=super_secret_pepper_salt
JWT_ACCESS_TOKEN_EXPIRY_DAYS=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=180
