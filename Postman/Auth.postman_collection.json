{
	"info": {
		"_postman_id": "a1b2c3d4-auth-4001-9000-000000000001",
		"name": "Gamified Quiz App - Auth API",
		"description": "Postman Collection for Client Authentication, Registration, 2FA/OTP login, Session Management, and Password Recovery in Gamified Quiz App.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Signup Flow",
			"item": [
				{
					"name": "Step 1: Send Verification Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"displayName\": \"Omkar\",\n  \"email\": \"test@gmail.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/signup/send-code",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"signup",
								"send-code"
							]
						},
						"description": "Step 1 of frontend signup flow: submits display name, email, and password. Validates constraints, enforces 60s cooldown and 5 req/15min rate limit, generates 6-digit OTP code, and logs code to console."
					},
					"response": []
				},
				{
					"name": "Step 2: Resend Verification Code",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@gmail.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/signup/resend-code",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"signup",
								"resend-code"
							]
						},
						"description": "Resends 6-digit OTP code if 60-second cooldown has passed. If still on cooldown, returns HTTP 429 with remaining seconds."
					},
					"response": []
				},
				{
					"name": "Step 3: Verify and Create Account",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@gmail.com\",\n  \"code\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/signup/verify",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"signup",
								"verify"
							]
						},
						"description": "Step 2 of frontend signup flow: verifies 6-digit OTP code, creates the user account in PostgreSQL, generates JWT access and refresh tokens, sets HTTP-only auth cookies, and logs the user in."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Login",
			"item": [
				{
					"name": "Login (Direct - Saves JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    if (jsonData.data.accessToken) {",
									"        pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
									"    }",
									"    if (jsonData.data.refreshToken) {",
									"        pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"player@example.com\",\n  \"password\": \"secretpassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Verifies password and directly returns JWT Access Token, sets HTTP-only cookies, and saves Refresh Token to DB."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Session & Tokens",
			"item": [
				{
					"name": "Get Client Session",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/session",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"session"
							]
						},
						"description": "Retrieves the safe session profile of the authenticated client."
					},
					"response": []
				},
				{
					"name": "Verify Session Active",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/verify-session",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"verify-session"
							]
						},
						"description": "Checks if the client session is currently active and valid."
					},
					"response": []
				},
				{
					"name": "Refresh Access Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"refresh"
							]
						},
						"description": "Issues a new JWT Access Token using the valid Refresh Token from payload or cookie."
					},
					"response": []
				},
				{
					"name": "Logout Client",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"logout"
							]
						},
						"description": "Revokes active session, adds Access Token JTI to Redis blacklist, clears DB refresh token, and removes cookies."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Password Management",
			"item": [
				{
					"name": "Change Password - Request OTP",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"oldPassword\": \"secretpassword123\",\n  \"newPassword\": \"newsecretpassword456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/change-password-request",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"change-password-request"
							]
						},
						"description": "Validates old credentials and stashes new password & verification OTP in Redis."
					},
					"response": []
				},
				{
					"name": "Change Password - Verify OTP",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"otp\": \"{{otp}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/change-password-verify",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"change-password-verify"
							]
						},
						"description": "Verifies OTP from Redis stash, hashes new password with bcrypt, and updates database record."
					},
					"response": []
				},
				{
					"name": "Forgot Password - Request Reset Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"resetToken\", jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"player@example.com\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/forgot-password",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"forgot-password"
							]
						},
						"description": "Generates a secure 64-char password reset token stored in Redis with 15-minute expiration."
					},
					"response": []
				},
				{
					"name": "Forgot Password - Validate Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{resetToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/forgot-password/verify",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"forgot-password",
								"verify"
							]
						},
						"description": "Checks whether the provided password reset token is active in Redis."
					},
					"response": []
				},
				{
					"name": "Forgot Password - Reset Password",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"completelyNewPassword789\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/forgot-password/reset",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"forgot-password",
								"reset"
							]
						},
						"description": "Consumes the reset token, updates the client password in PostgreSQL, and removes the Redis token."
					},
					"response": []
				}
			]
		}
	]
}
