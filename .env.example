# ==============================================================================
# Master Environment Variables Reference (.env.example)
# ==============================================================================

# Server Configuration
PORT=8080                                                    # Listening port (default: 8080, supports X_ZOHO_CATALYST_LISTEN_PORT)
ENV=development                                              # Environment: development | production | test
COOKIE_DOMAIN=localhost                                      # Domain for auth cookies (e.g. localhost or .yourdomain.com)
CORS_ALLOWED_ORIGINS=*                                       # Comma-separated allowed origins or * for open dev
GIN_MODE=debug                                               # debug | release (production sets release automatically)

# Seeding & Safety Controls
RUN_MIGRATIONS_ON_BOOT=true                                  # Set false when schema is owned by separate migration repo
SEED_ON_BOOT=true                                            # Auto-seed questions on boot (true in dev, false in prod)
SEED_DEMO_USER=true                                          # Seed player@example.com / secretpassword123 (true in dev, false in prod)
SEED_FORCE_REFRESH=false                                     # Force truncate & re-seed even if questions exist

# PostgreSQL Database Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=skillverse
POSTGRES_PASSWORD=skillverse_secrets
POSTGRES_DB=gamifiedapp
POSTGRES_SSLMODE=disable                                     # disable (local dev) | require (production/cloud)
DATABASE_URL=postgresql://skillverse:skillverse_secrets@127.0.0.1:5432/gamifiedapp?sslmode=disable

# Redis Cache Configuration (Optional - in-memory fallback used if empty)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_ADDR=localhost:6379                                   # Set to empty string to use zero-cost in-memory cache
REDIS_PASSWORD=
REDIS_DB=0

# pgAdmin (Docker environment only)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@skillverse.com
PGADMIN_DEFAULT_PASSWORD=admin

# Auth & Token Lifetimes
JWT_SECRET=super_secret_jwt_key_quizapp_2026
PASSWORD_SECRET=super_secret_pepper_salt
JWT_ACCESS_TOKEN_EXPIRY_DAYS=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=180
