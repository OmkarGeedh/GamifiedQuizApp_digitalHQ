# ==============================================================================
# Production Environment Configuration Template (.env.production.example)
# Copy to .env.production or configure these directly in your Cloud/Catalyst Console
# ==============================================================================

# Server Runtime
PORT=8080
ENV=production
GIN_MODE=release
COOKIE_DOMAIN=yourdomain.com
CORS_ALLOWED_ORIGINS=https://quiz.yourdomain.com,https://app.yourdomain.com

# Seeding & Migration Safety (In production, never auto-seed test users or wipe data)
RUN_MIGRATIONS_ON_BOOT=false     # Set false when migrations are owned by your separate migration repo
SEED_ON_BOOT=false
SEED_DEMO_USER=false
SEED_FORCE_REFRESH=false

# PostgreSQL Database (External Serverless Postgres: Neon, Supabase, or AWS RDS)
# Note: Always use sslmode=require for cloud-hosted databases
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?sslmode=require
POSTGRES_SSLMODE=require

# Redis Cache (Optional - Upstash Redis or leave empty to use in-memory sync.Map)
# Leaving REDIS_ADDR empty activates zero-cost built-in in-memory fallback
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security (USE STRONG, HIGH-ENTROPY SECRETS IN PRODUCTION)
JWT_SECRET=generate_a_random_64_char_secret_for_production_jwt
PASSWORD_SECRET=generate_a_random_64_char_pepper_salt_for_passwords
JWT_ACCESS_TOKEN_EXPIRY_DAYS=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=180
